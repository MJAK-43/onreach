# On'Reach — Variables d'environnement (copier vers .env)
# NE JAMAIS committer le fichier .env avec des secrets réels

APP_ENV=dev
APP_SECRET=change_me_generate_random_secret

POSTGRES_DB=onreach
POSTGRES_USER=onreach
POSTGRES_PASSWORD=change_me_postgres_password

REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=onreach
MINIO_ROOT_PASSWORD=change_me_minio_password

JWT_PASSPHRASE=change_me_jwt_passphrase

SEED_ADMIN_EMAIL=admin@onreach.inovixora.fr
SEED_ADMIN_PASSWORD=Admin@OnReach12!
SEED_COUNSELOR_EMAIL=marie.kouassi@onreach.inovixora.fr
SEED_COUNSELOR_PASSWORD=Counselor@OnReach12!
SEED_CANDIDATE_USER_EMAIL=mohamed.koffi@onreach.inovixora.fr
SEED_CANDIDATE_USER_PASSWORD=Candidate@OnReach12!
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem

CORS_ALLOW_ORIGIN='^https?://(frontend\.localhost|localhost)(:[0-9]+)?$$'

MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages

OPENAI_API_KEY=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

VITE_API_URL=http://api.localhost

MAILER_DSN=null://null
MAILER_FROM=noreply@onreach.inovixora.fr
FRONTEND_URL=http://localhost:5173

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
